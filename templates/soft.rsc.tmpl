:local susaninAccuracyProfile "{{ACCURACY_PROFILE}}"
:if ([/system script job print count-only as-value where script=[:jobname]] > 1) do={ :exit }
:local healthRule [/ip firewall mangle find where comment="AUTO-AWG: L1 mark test"]
:if ([:len $healthRule] = 0) do={ :exit }
:if ([/ip firewall mangle get $healthRule disabled] = true) do={ :exit }

# FAST, MIDDLE and SLOW share the accepted detector/JUDGE
# thresholds. Accuracy profiles change evidence transitions only.

:local susaninSnapshotOK true
:local conns
:onerror susaninSnapshotError in={
  :set conns [/ip firewall connection print as-value where ((protocol=tcp and tcp-state=established) or (protocol=udp and (seen-reply=no or (dst-port=443 and seen-reply=yes))))]
} do={
  :set susaninSnapshotOK false
}
:if ($susaninSnapshotOK = false) do={ :exit }

:foreach c in=$conns do={
  :onerror susaninFlowError in={
  :local proto [:tostr ($c->"protocol")]
  :local id ($c->".id")
  :local src [:toip ($c->"src-address")]
  :local dst [:toip ($c->"dst-address")]
  :local port ($c->"dst-port")
  :local mark [:tostr ($c->"connection-mark")]
  :local watchList ("auto_awg_watch_" . $proto . "_" . [:tostr $port])
  :local testList ("auto_awg_test_" . $proto . "_" . [:tostr $port])
  :local okList ("auto_awg_ok_" . $proto . "_" . [:tostr $port])
  :local coolList ("auto_awg_cooldown_" . $proto . "_" . [:tostr $port])
  :local direct1List ("auto_awg_direct1_" . $proto . "_" . [:tostr $port])
  :local awg1List ("auto_awg_awg1_" . $proto . "_" . [:tostr $port])
  :local recheckList ("auto_awg_recheck_" . $proto . "_" . [:tostr $port])
  :local op ($c->"orig-packets")
  :local rp ($c->"repl-packets")

  :if ($proto = "tcp") do={
    :local ob ($c->"orig-bytes")
    :local rb ($c->"repl-bytes")
    :local orate [:tostr ($c->"orig-rate")]
    :local rrate [:tostr ($c->"repl-rate")]

    {{LAN_MATCH}}

    :if ((($mark = "") || ($mark = "no-mark")) && ($fromLAN = true)) do={
      :if (!(($dst in 0.0.0.0/8) || ($dst in 10.0.0.0/8) || ($dst in 100.64.0.0/10) || ($dst in 127.0.0.0/8) || ($dst in 169.254.0.0/16) || ($dst in 172.16.0.0/12) || ($dst in 192.168.0.0/16) || ($dst in 224.0.0.0/4) || ($dst in 240.0.0.0/4))) do={
        :local trigger false
        :local reason ""
        :local suspicious false

        :if (($op >= 5) && ($ob >= 1000) && ($rp <= 2) && ($rb < 256)) do={
          :set trigger true
          :set reason "TCP-STALL"
        }

        :local origActive true
        :local replSilent false

        :if (($orate = "") || ($orate = "0") || ($orate = "0bps")) do={ :set origActive false }
        :if (($rrate = "") || ($rrate = "0") || ($rrate = "0bps")) do={ :set replSilent true }

        :if (($trigger = false) && ($op >= 8) && ($rp > 0) && ($origActive = true) && ($replSilent = true)) do={
          :set suspicious true
        }

        :local directHit false

        :if (($trigger = true) || ($suspicious = true)) do={
          :if ([:len [/ip firewall address-list find where list="vpn_direct" and address=$dst]] > 0) do={
            :set directHit true
          }
        }

        :if (($directHit = false) && ($trigger = false) && ($suspicious = true)) do={
          :local wid [/ip firewall address-list find where list=$watchList and address=$dst]

          :if ([:len $wid] = 0) do={
            :if (([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0)) do={
              /ip firewall address-list add list=$watchList address=$dst timeout=8s comment=("TCP-LATE-STALL " . [:tostr $port])
            }
          } else={
            :onerror err in={
              :local left [/ip firewall address-list get $wid timeout]
              :if ($left <= 4s) do={
                :set trigger true
                :set reason "TCP-LATE-STALL"
              }
            } do={}
          }
        }

        :if (($directHit = false) && ($trigger = true)) do={
          :if (([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0)) do={
            :local lazyReady true
            :local profileProceed true
            :local slowRecheck false

            :if ($susaninAccuracyProfile = "slow") do={
              :local slowRecheckIds [/ip firewall address-list find where list=$recheckList and address=$dst]
              :local slowAwg1Ids [/ip firewall address-list find where list=$awg1List and address=$dst]

              :if (([:len $slowRecheckIds] > 0) && ([:len $slowAwg1Ids] > 0)) do={
                :set slowRecheck true
              } else={
                :if (([:len $slowRecheckIds] > 0) || ([:len $slowAwg1Ids] > 0)) do={
                  :local staleEvidenceOK true

                  :onerror slowStaleRecheckClearError in={
                    /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :onerror slowStaleAwg1ClearError in={
                    /ip firewall address-list remove [find where list=$awg1List and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :onerror slowStaleDirect1ClearError in={
                    /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :if (([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0)) do={
                    :set staleEvidenceOK false
                  }

                  :if ($staleEvidenceOK = false) do={
                    :set profileProceed false
                    :set lazyReady false

                    :if ({{LOG_ERROR}}) do={
                      :log warning ("AUTO-AWG: SLOW stale evidence cleanup failed for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                    }
                  }
                }
              }
            }

            :if (($susaninAccuracyProfile = "middle") || (($susaninAccuracyProfile = "slow") && ($slowRecheck = false) && ($profileProceed = true))) do={
              :local direct1Ids [/ip firewall address-list find where list=$direct1List and address=$dst]
              :local currentEvidenceComment ("DEV3 DIRECT1 " . [:tostr $id])
              :local sameEvidence false
              :local evidenceReadable true

              :foreach direct1EvidenceId in=$direct1Ids do={
                :onerror direct1ReadError in={
                  :local firstEvidenceComment [:tostr [/ip firewall address-list get $direct1EvidenceId comment]]

                  :if ($firstEvidenceComment = $currentEvidenceComment) do={
                    :set sameEvidence true
                  }
                } do={
                  :set evidenceReadable false
                }
              }

              :if ([:len $direct1Ids] = 0) do={
                :local evidenceAdded true

                :onerror direct1AddError in={
                  /ip firewall address-list add list=$direct1List address=$dst timeout=2m comment=$currentEvidenceComment
                } do={
                  :set evidenceAdded false
                }

                :if ($evidenceAdded = true) do={
                  :onerror direct1ConnRemoveError in={
                    /ip firewall connection remove $id
                  } do={}

                  :set profileProceed false
                  :set lazyReady false

                  :if ({{LOG_DEBUG}}) do={
                    :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence 1 " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                } else={
                  :set profileProceed false
                  :set lazyReady false

                  :if ({{LOG_ERROR}}) do={
                    :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence state unavailable for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                }
              } else={
                :if (($evidenceReadable = false) || ($sameEvidence = true)) do={
                  :onerror direct1RepeatRemoveError in={
                    /ip firewall connection remove $id
                  } do={}

                  :set profileProceed false
                  :set lazyReady false
                }
              }
            }
            :local routeAnchor [/ip firewall mangle find where comment="AUTO-AWG: L2 route confirmed"]
            :local okRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " OK")
            :local testRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " TEST")

            :if ([:len $routeAnchor] != 1) do={
              :set lazyReady false
            }

            :if ($lazyReady = true) do={
              :local okRules [/ip firewall mangle find where comment=$okRuleComment]

              :if ([:len $okRules] = 0) do={
                :onerror lazyOkCreateError in={
                  /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$okList connection-mark=no-mark new-connection-mark=auto-awg-ok-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$okRuleComment place-before=$routeAnchor
                } do={
                  :set lazyReady false
                }
              }

              :if ($lazyReady = true) do={
                :set okRules [/ip firewall mangle find where comment=$okRuleComment]

                :if ([:len $okRules] > 1) do={
                  :local keepFirst true

                  :foreach lazyRuleId in=$okRules do={
                    :if ($keepFirst = true) do={
                      :set keepFirst false
                    } else={
                      :onerror lazyDupRemoveError in={
                        /ip firewall mangle remove $lazyRuleId
                      } do={}
                    }
                  }

                  :set okRules [/ip firewall mangle find where comment=$okRuleComment]
                }

                :if ([:len $okRules] != 1) do={
                  :set lazyReady false
                }
              }
            }

            :if ($lazyReady = true) do={
              :local testRules [/ip firewall mangle find where comment=$testRuleComment]

              :if ([:len $testRules] = 0) do={
                :onerror lazyTestCreateError in={
                  /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$testList connection-mark=no-mark new-connection-mark=auto-awg-test-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$testRuleComment place-before=$routeAnchor
                } do={
                  :set lazyReady false
                }
              }

              :if ($lazyReady = true) do={
                :set testRules [/ip firewall mangle find where comment=$testRuleComment]

                :if ([:len $testRules] > 1) do={
                  :local keepFirst true

                  :foreach lazyRuleId in=$testRules do={
                    :if ($keepFirst = true) do={
                      :set keepFirst false
                    } else={
                      :onerror lazyDupRemoveError in={
                        /ip firewall mangle remove $lazyRuleId
                      } do={}
                    }
                  }

                  :set testRules [/ip firewall mangle find where comment=$testRuleComment]
                }

                :if ([:len $testRules] != 1) do={
                  :set lazyReady false
                }
              }
            }

            :if ($lazyReady = true) do={
              :if (($susaninAccuracyProfile = "middle") || ($susaninAccuracyProfile = "slow")) do={
                :local profileStateOK true

                :onerror direct1ClearError in={
                  /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                } do={
                  :set profileStateOK false
                }

                :if ([:len [/ip firewall address-list find where list=$direct1List and address=$dst]] > 0) do={
                  :set profileStateOK false
                }

                :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = true)) do={
                  :onerror slowRecheckClearError in={
                    /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                  } do={
                    :set profileStateOK false
                  }

                  :if ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) do={
                    :set profileStateOK false
                  }

                  :if ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] = 0) do={
                    :set profileStateOK false
                  }

                  :if (($profileStateOK = true) && ({{LOG_DEBUG}})) do={
                    :log warning ("AUTO-AWG: SLOW DIRECT re-check failed again " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                }

                :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = false)) do={
                  :if (([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0)) do={
                    :set profileStateOK false
                  }
                }

                :if ($profileStateOK = false) do={
                  :error "DEV3 profile transition evidence cleanup failed"
                }
              }
              :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
              /ip firewall address-list add list=$testList address=$dst timeout=1m comment=($reason . " " . [:tostr $port])
              :if ({{LOG_DEBUG}}) do={ :log warning ("AUTO-AWG: SOFT " . $reason . " " . [:tostr $dst] . ":" . [:tostr $port]) }
              :onerror err in={ /ip firewall connection remove $id } do={}
            } else={
              :if (($profileProceed = true) && ({{LOG_ERROR}})) do={
                :log warning ("AUTO-AWG: lazy rules unavailable for " . $proto . ":" . [:tostr $port] . ", keeping DIRECT")
              }
            }
          }
        }
      }
    }
  }

  :if ($proto = "udp") do={
    :local seen [:tostr ($c->"seen-reply")]
    :local seenReply false

    :if (($seen = "true") || ($seen = "yes")) do={
      :set seenReply true
    }

    :if (($seenReply = false) && ($port != 443) && ($port != 53) && ($port != 67) && ($port != 68) && ($port != 123) && ($op >= 12) && ($rp = 0)) do={
      {{LAN_MATCH}}

      :if ((($mark = "") || ($mark = "no-mark")) && ($fromLAN = true)) do={
        :if (!(($dst in 0.0.0.0/8) || ($dst in 10.0.0.0/8) || ($dst in 100.64.0.0/10) || ($dst in 127.0.0.0/8) || ($dst in 169.254.0.0/16) || ($dst in 172.16.0.0/12) || ($dst in 192.168.0.0/16) || ($dst in 224.0.0.0/4) || ($dst in 240.0.0.0/4))) do={
          :local directHit false

          :if ([:len [/ip firewall address-list find where list="vpn_direct" and address=$dst]] > 0) do={
            :set directHit true
          }

          :if (($directHit = false) && ([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0)) do={
            :local lazyReady true
            :local profileProceed true
            :local slowRecheck false

            :if ($susaninAccuracyProfile = "slow") do={
              :local slowRecheckIds [/ip firewall address-list find where list=$recheckList and address=$dst]
              :local slowAwg1Ids [/ip firewall address-list find where list=$awg1List and address=$dst]

              :if (([:len $slowRecheckIds] > 0) && ([:len $slowAwg1Ids] > 0)) do={
                :set slowRecheck true
              } else={
                :if (([:len $slowRecheckIds] > 0) || ([:len $slowAwg1Ids] > 0)) do={
                  :local staleEvidenceOK true

                  :onerror slowStaleRecheckClearError in={
                    /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :onerror slowStaleAwg1ClearError in={
                    /ip firewall address-list remove [find where list=$awg1List and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :onerror slowStaleDirect1ClearError in={
                    /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                  } do={
                    :set staleEvidenceOK false
                  }

                  :if (([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0)) do={
                    :set staleEvidenceOK false
                  }

                  :if ($staleEvidenceOK = false) do={
                    :set profileProceed false
                    :set lazyReady false

                    :if ({{LOG_ERROR}}) do={
                      :log warning ("AUTO-AWG: SLOW stale evidence cleanup failed for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                    }
                  }
                }
              }
            }

            :if (($susaninAccuracyProfile = "middle") || (($susaninAccuracyProfile = "slow") && ($slowRecheck = false) && ($profileProceed = true))) do={
              :local direct1Ids [/ip firewall address-list find where list=$direct1List and address=$dst]
              :local currentEvidenceComment ("DEV3 DIRECT1 " . [:tostr $id])
              :local sameEvidence false
              :local evidenceReadable true

              :foreach direct1EvidenceId in=$direct1Ids do={
                :onerror direct1ReadError in={
                  :local firstEvidenceComment [:tostr [/ip firewall address-list get $direct1EvidenceId comment]]

                  :if ($firstEvidenceComment = $currentEvidenceComment) do={
                    :set sameEvidence true
                  }
                } do={
                  :set evidenceReadable false
                }
              }

              :if ([:len $direct1Ids] = 0) do={
                :local evidenceAdded true

                :onerror direct1AddError in={
                  /ip firewall address-list add list=$direct1List address=$dst timeout=2m comment=$currentEvidenceComment
                } do={
                  :set evidenceAdded false
                }

                :if ($evidenceAdded = true) do={
                  :onerror direct1ConnRemoveError in={
                    /ip firewall connection remove $id
                  } do={}

                  :set profileProceed false
                  :set lazyReady false

                  :if ({{LOG_DEBUG}}) do={
                    :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence 1 " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                } else={
                  :set profileProceed false
                  :set lazyReady false

                  :if ({{LOG_ERROR}}) do={
                    :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence state unavailable for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                }
              } else={
                :if (($evidenceReadable = false) || ($sameEvidence = true)) do={
                  :onerror direct1RepeatRemoveError in={
                    /ip firewall connection remove $id
                  } do={}

                  :set profileProceed false
                  :set lazyReady false
                }
              }
            }
            :local routeAnchor [/ip firewall mangle find where comment="AUTO-AWG: L2 route confirmed"]
            :local okRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " OK")
            :local testRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " TEST")

            :if ([:len $routeAnchor] != 1) do={
              :set lazyReady false
            }

            :if ($lazyReady = true) do={
              :local okRules [/ip firewall mangle find where comment=$okRuleComment]

              :if ([:len $okRules] = 0) do={
                :onerror lazyOkCreateError in={
                  /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$okList connection-mark=no-mark new-connection-mark=auto-awg-ok-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$okRuleComment place-before=$routeAnchor
                } do={
                  :set lazyReady false
                }
              }

              :if ($lazyReady = true) do={
                :set okRules [/ip firewall mangle find where comment=$okRuleComment]

                :if ([:len $okRules] > 1) do={
                  :local keepFirst true

                  :foreach lazyRuleId in=$okRules do={
                    :if ($keepFirst = true) do={
                      :set keepFirst false
                    } else={
                      :onerror lazyDupRemoveError in={
                        /ip firewall mangle remove $lazyRuleId
                      } do={}
                    }
                  }

                  :set okRules [/ip firewall mangle find where comment=$okRuleComment]
                }

                :if ([:len $okRules] != 1) do={
                  :set lazyReady false
                }
              }
            }

            :if ($lazyReady = true) do={
              :local testRules [/ip firewall mangle find where comment=$testRuleComment]

              :if ([:len $testRules] = 0) do={
                :onerror lazyTestCreateError in={
                  /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$testList connection-mark=no-mark new-connection-mark=auto-awg-test-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$testRuleComment place-before=$routeAnchor
                } do={
                  :set lazyReady false
                }
              }

              :if ($lazyReady = true) do={
                :set testRules [/ip firewall mangle find where comment=$testRuleComment]

                :if ([:len $testRules] > 1) do={
                  :local keepFirst true

                  :foreach lazyRuleId in=$testRules do={
                    :if ($keepFirst = true) do={
                      :set keepFirst false
                    } else={
                      :onerror lazyDupRemoveError in={
                        /ip firewall mangle remove $lazyRuleId
                      } do={}
                    }
                  }

                  :set testRules [/ip firewall mangle find where comment=$testRuleComment]
                }

                :if ([:len $testRules] != 1) do={
                  :set lazyReady false
                }
              }
            }

            :if ($lazyReady = true) do={
              :if (($susaninAccuracyProfile = "middle") || ($susaninAccuracyProfile = "slow")) do={
                :local profileStateOK true

                :onerror direct1ClearError in={
                  /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                } do={
                  :set profileStateOK false
                }

                :if ([:len [/ip firewall address-list find where list=$direct1List and address=$dst]] > 0) do={
                  :set profileStateOK false
                }

                :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = true)) do={
                  :onerror slowRecheckClearError in={
                    /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                  } do={
                    :set profileStateOK false
                  }

                  :if ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) do={
                    :set profileStateOK false
                  }

                  :if ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] = 0) do={
                    :set profileStateOK false
                  }

                  :if (($profileStateOK = true) && ({{LOG_DEBUG}})) do={
                    :log warning ("AUTO-AWG: SLOW DIRECT re-check failed again " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                  }
                }

                :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = false)) do={
                  :if (([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0)) do={
                    :set profileStateOK false
                  }
                }

                :if ($profileStateOK = false) do={
                  :error "DEV3 profile transition evidence cleanup failed"
                }
              }
              :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
              /ip firewall address-list add list=$testList address=$dst timeout=1m comment=("UDP " . [:tostr $port])
              :if ({{LOG_DEBUG}}) do={ :log warning ("AUTO-AWG: SOFT UDP " . [:tostr $dst] . ":" . [:tostr $port]) }
              :onerror err in={ /ip firewall connection remove $id } do={}
            } else={
              :if (($profileProceed = true) && ({{LOG_ERROR}})) do={
                :log warning ("AUTO-AWG: lazy rules unavailable for " . $proto . ":" . [:tostr $port] . ", keeping DIRECT")
              }
            }
          }
        }
      }
    }

    :if (($seenReply = true) && ($port = 443)) do={
      :local orate [:tostr ($c->"orig-rate")]
      :local rrate [:tostr ($c->"repl-rate")]

      {{LAN_MATCH}}

      :local origActive true
      :local replSilent false

      :if (($orate = "") || ($orate = "0") || ($orate = "0bps")) do={ :set origActive false }
      :if (($rrate = "") || ($rrate = "0") || ($rrate = "0bps")) do={ :set replSilent true }

      :if ((($mark = "") || ($mark = "no-mark")) && ($fromLAN = true) && ($op >= 8) && ($origActive = true) && ($replSilent = true)) do={
        :if (!(($dst in 0.0.0.0/8) || ($dst in 10.0.0.0/8) || ($dst in 100.64.0.0/10) || ($dst in 127.0.0.0/8) || ($dst in 169.254.0.0/16) || ($dst in 172.16.0.0/12) || ($dst in 192.168.0.0/16) || ($dst in 224.0.0.0/4) || ($dst in 240.0.0.0/4))) do={
          :local directHit false

          :if ([:len [/ip firewall address-list find where list="vpn_direct" and address=$dst]] > 0) do={
            :set directHit true
          }

          :if ($directHit = false) do={
            :local wid [/ip firewall address-list find where list=$watchList and address=$dst]

            :if ([:len $wid] = 0) do={
              :if (([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0)) do={
                /ip firewall address-list add list=$watchList address=$dst timeout=8s comment="QUIC-LATE-STALL 443"
              }
            } else={
              :onerror err in={
                :local left [/ip firewall address-list get $wid timeout]

                :if ($left <= 4s) do={
                  :if (([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] = 0) && ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0)) do={
                    :local lazyReady true
                    :local profileProceed true
                    :local slowRecheck false

                    :if ($susaninAccuracyProfile = "slow") do={
                      :local slowRecheckIds [/ip firewall address-list find where list=$recheckList and address=$dst]
                      :local slowAwg1Ids [/ip firewall address-list find where list=$awg1List and address=$dst]

                      :if (([:len $slowRecheckIds] > 0) && ([:len $slowAwg1Ids] > 0)) do={
                        :set slowRecheck true
                      } else={
                        :if (([:len $slowRecheckIds] > 0) || ([:len $slowAwg1Ids] > 0)) do={
                          :local staleEvidenceOK true

                          :onerror slowStaleRecheckClearError in={
                            /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                          } do={
                            :set staleEvidenceOK false
                          }

                          :onerror slowStaleAwg1ClearError in={
                            /ip firewall address-list remove [find where list=$awg1List and address=$dst]
                          } do={
                            :set staleEvidenceOK false
                          }

                          :onerror slowStaleDirect1ClearError in={
                            /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                          } do={
                            :set staleEvidenceOK false
                          }

                          :if (([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0)) do={
                            :set staleEvidenceOK false
                          }

                          :if ($staleEvidenceOK = false) do={
                            :set profileProceed false
                            :set lazyReady false

                            :if ({{LOG_ERROR}}) do={
                              :log warning ("AUTO-AWG: SLOW stale evidence cleanup failed for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                            }
                          }
                        }
                      }
                    }

                    :if (($susaninAccuracyProfile = "middle") || (($susaninAccuracyProfile = "slow") && ($slowRecheck = false) && ($profileProceed = true))) do={
                      :local direct1Ids [/ip firewall address-list find where list=$direct1List and address=$dst]
                      :local currentEvidenceComment ("DEV3 DIRECT1 " . [:tostr $id])
                      :local sameEvidence false
                      :local evidenceReadable true

                      :foreach direct1EvidenceId in=$direct1Ids do={
                        :onerror direct1ReadError in={
                          :local firstEvidenceComment [:tostr [/ip firewall address-list get $direct1EvidenceId comment]]

                          :if ($firstEvidenceComment = $currentEvidenceComment) do={
                            :set sameEvidence true
                          }
                        } do={
                          :set evidenceReadable false
                        }
                      }

                      :if ([:len $direct1Ids] = 0) do={
                        :local evidenceAdded true

                        :onerror direct1AddError in={
                          /ip firewall address-list add list=$direct1List address=$dst timeout=2m comment=$currentEvidenceComment
                        } do={
                          :set evidenceAdded false
                        }

                        :if ($evidenceAdded = true) do={
                          :onerror direct1ConnRemoveError in={
                            /ip firewall connection remove $id
                          } do={}

                          :set profileProceed false
                          :set lazyReady false

                          :if ({{LOG_DEBUG}}) do={
                            :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence 1 " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                          }
                        } else={
                          :set profileProceed false
                          :set lazyReady false

                          :if ({{LOG_ERROR}}) do={
                            :log warning ("AUTO-AWG: " . $susaninAccuracyProfile . " DIRECT evidence state unavailable for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                          }
                        }
                      } else={
                        :if (($evidenceReadable = false) || ($sameEvidence = true)) do={
                          :onerror direct1RepeatRemoveError in={
                            /ip firewall connection remove $id
                          } do={}

                          :set profileProceed false
                          :set lazyReady false
                        }
                      }
                    }
                    :local routeAnchor [/ip firewall mangle find where comment="AUTO-AWG: L2 route confirmed"]
                    :local okRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " OK")
                    :local testRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " TEST")

                    :if ([:len $routeAnchor] != 1) do={
                      :set lazyReady false
                    }

                    :if ($lazyReady = true) do={
                      :local okRules [/ip firewall mangle find where comment=$okRuleComment]

                      :if ([:len $okRules] = 0) do={
                        :onerror lazyOkCreateError in={
                          /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$okList connection-mark=no-mark new-connection-mark=auto-awg-ok-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$okRuleComment place-before=$routeAnchor
                        } do={
                          :set lazyReady false
                        }
                      }

                      :if ($lazyReady = true) do={
                        :set okRules [/ip firewall mangle find where comment=$okRuleComment]

                        :if ([:len $okRules] > 1) do={
                          :local keepFirst true

                          :foreach lazyRuleId in=$okRules do={
                            :if ($keepFirst = true) do={
                              :set keepFirst false
                            } else={
                              :onerror lazyDupRemoveError in={
                                /ip firewall mangle remove $lazyRuleId
                              } do={}
                            }
                          }

                          :set okRules [/ip firewall mangle find where comment=$okRuleComment]
                        }

                        :if ([:len $okRules] != 1) do={
                          :set lazyReady false
                        }
                      }
                    }

                    :if ($lazyReady = true) do={
                      :local testRules [/ip firewall mangle find where comment=$testRuleComment]

                      :if ([:len $testRules] = 0) do={
                        :onerror lazyTestCreateError in={
                          /ip firewall mangle add chain=prerouting action=mark-connection protocol=$proto dst-port=$port dst-address-list=$testList connection-mark=no-mark new-connection-mark=auto-awg-test-conn connection-state=new dst-address-type=!local in-interface-list="{{LAN_LIST}}" passthrough=yes disabled=no comment=$testRuleComment place-before=$routeAnchor
                        } do={
                          :set lazyReady false
                        }
                      }

                      :if ($lazyReady = true) do={
                        :set testRules [/ip firewall mangle find where comment=$testRuleComment]

                        :if ([:len $testRules] > 1) do={
                          :local keepFirst true

                          :foreach lazyRuleId in=$testRules do={
                            :if ($keepFirst = true) do={
                              :set keepFirst false
                            } else={
                              :onerror lazyDupRemoveError in={
                                /ip firewall mangle remove $lazyRuleId
                              } do={}
                            }
                          }

                          :set testRules [/ip firewall mangle find where comment=$testRuleComment]
                        }

                        :if ([:len $testRules] != 1) do={
                          :set lazyReady false
                        }
                      }
                    }

                    :if ($lazyReady = true) do={
                      :if (($susaninAccuracyProfile = "middle") || ($susaninAccuracyProfile = "slow")) do={
                        :local profileStateOK true

                        :onerror direct1ClearError in={
                          /ip firewall address-list remove [find where list=$direct1List and address=$dst]
                        } do={
                          :set profileStateOK false
                        }

                        :if ([:len [/ip firewall address-list find where list=$direct1List and address=$dst]] > 0) do={
                          :set profileStateOK false
                        }

                        :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = true)) do={
                          :onerror slowRecheckClearError in={
                            /ip firewall address-list remove [find where list=$recheckList and address=$dst]
                          } do={
                            :set profileStateOK false
                          }

                          :if ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0) do={
                            :set profileStateOK false
                          }

                          :if ([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] = 0) do={
                            :set profileStateOK false
                          }

                          :if (($profileStateOK = true) && ({{LOG_DEBUG}})) do={
                            :log warning ("AUTO-AWG: SLOW DIRECT re-check failed again " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                          }
                        }

                        :if (($susaninAccuracyProfile = "slow") && ($slowRecheck = false)) do={
                          :if (([:len [/ip firewall address-list find where list=$awg1List and address=$dst]] > 0) || ([:len [/ip firewall address-list find where list=$recheckList and address=$dst]] > 0)) do={
                            :set profileStateOK false
                          }
                        }

                        :if ($profileStateOK = false) do={
                          :error "DEV3 profile transition evidence cleanup failed"
                        }
                      }
                      :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
                      /ip firewall address-list add list=$testList address=$dst timeout=1m comment="QUIC-LATE-STALL 443"
                      :if ({{LOG_DEBUG}}) do={ :log warning ("AUTO-AWG: SOFT QUIC-LATE-STALL " . [:tostr $dst] . ":443") }
                      :onerror err in={ /ip firewall connection remove $id } do={}
                    } else={
                      :if (($profileProceed = true) && ({{LOG_ERROR}})) do={
                        :log warning ("AUTO-AWG: lazy rules unavailable for " . $proto . ":" . [:tostr $port] . ", keeping DIRECT")
                      }
                    }
                  }
                }
              } do={}
            }
          }
        }
      }
    }
  }
  } do={}
}
