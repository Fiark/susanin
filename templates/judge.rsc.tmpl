:local susaninAccuracyProfile "{{ACCURACY_PROFILE}}"
:if ([/system script job print count-only as-value where script=[:jobname]] > 1) do={ :exit }
:local healthRule [/ip firewall mangle find where comment="AUTO-AWG: L1 mark test"]
:if ([:len $healthRule] = 0) do={ :exit }
:if ([/ip firewall mangle get $healthRule disabled] = true) do={ :exit }

# FAST, MIDDLE and SLOW share the accepted detector/JUDGE
# thresholds. Accuracy profiles change evidence transitions only.

# RouterOS 7.23.3 can successfully filter the live connection table by
# dynamic connection-mark while returning connection-mark as an empty value
# inside the corresponding "print as-value" map.
#
# Query TEST and OK marks separately and carry the known mark from the exact
# query instead of reading the unreliable dynamic property back from the map.
:foreach connMark in={"auto-awg-test-conn";"auto-awg-ok-conn"} do={
  :local susaninSnapshotOK true
  :local conns

  :onerror susaninSnapshotError in={
    :if ($connMark = "auto-awg-test-conn") do={
      :set conns [/ip firewall connection print as-value where connection-mark=auto-awg-test-conn]
    } else={
      :set conns [/ip firewall connection print as-value where connection-mark=auto-awg-ok-conn]
    }
  } do={
    :set susaninSnapshotOK false
  }

  :if ($susaninSnapshotOK = false) do={ :exit }

  :foreach c in=$conns do={
  :onerror susaninFlowError in={
  :local id ($c->".id")
  :local src [:toip ($c->"src-address")]
  :local dst [:toip ($c->"dst-address")]
  :local port ($c->"dst-port")
  :local proto [:tostr ($c->"protocol")]
  :local op ($c->"orig-packets")
  :local rp ($c->"repl-packets")
  :local ob ($c->"orig-bytes")
  :local rb ($c->"repl-bytes")

  {{LAN_MATCH}}

  :if ($fromLAN = true) do={
    :local testList ""
    :local okList ""
    :local watchList ""
    :local coolList ""
    :local direct1List ""
    :local awg1List ""
    :local recheckList ""

    :if ($proto = "tcp") do={
      :set testList ("auto_awg_test_tcp_" . [:tostr $port])
      :set okList ("auto_awg_ok_tcp_" . [:tostr $port])
      :set watchList ("auto_awg_watch_tcp_" . [:tostr $port])
      :set coolList ("auto_awg_cooldown_tcp_" . [:tostr $port])
      :set direct1List ("auto_awg_direct1_tcp_" . [:tostr $port])
      :set awg1List ("auto_awg_awg1_tcp_" . [:tostr $port])
      :set recheckList ("auto_awg_recheck_tcp_" . [:tostr $port])
    }

    :if ($proto = "udp") do={
      :set testList ("auto_awg_test_udp_" . [:tostr $port])
      :set okList ("auto_awg_ok_udp_" . [:tostr $port])
      :set watchList ("auto_awg_watch_udp_" . [:tostr $port])
      :set coolList ("auto_awg_cooldown_udp_" . [:tostr $port])
      :set direct1List ("auto_awg_direct1_udp_" . [:tostr $port])
      :set awg1List ("auto_awg_awg1_udp_" . [:tostr $port])
      :set recheckList ("auto_awg_recheck_udp_" . [:tostr $port])
    }

    :local directHit false

    :if ([:len [/ip firewall address-list find where list="vpn_direct" and address=$dst]] > 0) do={
      :set directHit true
    }

    :if (($directHit = false) && ($connMark = "auto-awg-test-conn") && ($testList != "") && ([:len [/ip firewall address-list find where list=$testList and address=$dst]] > 0)) do={
      :local good false
      :local failed false

      :if ($proto = "tcp") do={
        :local state [:tostr ($c->"tcp-state")]

        :if (($rp >= 2) || ($rb >= 128)) do={
          :set good true
        }

        :if (($state = "syn-sent") && ($op >= 3) && ($rp = 0)) do={
          :set failed true
        }

        :if (($state = "established") && ($op >= 10) && ($ob >= 3000) && ($rp <= 1) && ($rb < 128)) do={
          :set failed true
        }
      }

      :if ($proto = "udp") do={
        :if ($rp >= 1) do={
          :set good true
        }

        :if (($port = 443) && ($op >= 10) && ($rp = 0)) do={
          :set failed true
        }

        :if (($port != 443) && ($op >= 20) && ($rp = 0)) do={
          :set failed true
        }
      }

      :if ($good = true) do={
        :local confirmOK true

        :if (($susaninAccuracyProfile = "middle") || ($susaninAccuracyProfile = "slow")) do={
          :set confirmOK false

          :local awg1Ids [/ip firewall address-list find where list=$awg1List and address=$dst]
          :local currentEvidenceComment ("DEV3 AWG1 " . [:tostr $id])
          :local sameEvidence false
          :local evidenceReadable true

          :foreach awg1EvidenceId in=$awg1Ids do={
            :onerror awg1ReadError in={
              :local firstEvidenceComment [:tostr [/ip firewall address-list get $awg1EvidenceId comment]]

              :if ($firstEvidenceComment = $currentEvidenceComment) do={
                :set sameEvidence true
              }
            } do={
              :set evidenceReadable false
            }
          }

          :if ($susaninAccuracyProfile = "middle") do={
            :if ([:len $awg1Ids] = 0) do={
              :local evidenceAdded true

              :onerror awg1AddError in={
                /ip firewall address-list add list=$awg1List address=$dst timeout=2m comment=$currentEvidenceComment
              } do={
                :set evidenceAdded false
              }

              :if ($evidenceAdded = true) do={
                :onerror awg1ConnRemoveError in={
                  /ip firewall connection remove $id
                } do={}

                :if ({{LOG_DEBUG}}) do={
                  :log warning ("AUTO-AWG: MIDDLE AWG evidence 1 " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                }
              } else={
                :if ({{LOG_ERROR}}) do={
                  :log warning ("AUTO-AWG: MIDDLE AWG evidence state unavailable for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                }
              }
            } else={
              :if (($evidenceReadable = false) || ($sameEvidence = true)) do={
                :onerror awg1RepeatRemoveError in={
                  /ip firewall connection remove $id
                } do={}
              } else={
                :set confirmOK true
              }
            }
          }

          :if ($susaninAccuracyProfile = "slow") do={
            :local recheckIds [/ip firewall address-list find where list=$recheckList and address=$dst]

            :if ([:len $awg1Ids] = 0) do={
              :local slowStateReady true

              :onerror slowOldRecheckClearError in={
                /ip firewall address-list remove [find where list=$recheckList and address=$dst]
              } do={
                :set slowStateReady false
              }

              :if ($slowStateReady = true) do={
                :onerror slowAwg1AddError in={
                  /ip firewall address-list add list=$awg1List address=$dst timeout=2m comment=$currentEvidenceComment
                } do={
                  :set slowStateReady false
                }
              }

              :if ($slowStateReady = true) do={
                :onerror slowRecheckAddError in={
                  /ip firewall address-list add list=$recheckList address=$dst timeout=2m comment=("DEV3 RECHECK " . [:tostr $id])
                } do={
                  :set slowStateReady false
                }
              }

              :if ($slowStateReady = true) do={
                :local awg1Now [/ip firewall address-list find where list=$awg1List and address=$dst]
                :local recheckNow [/ip firewall address-list find where list=$recheckList and address=$dst]

                :if (([:len $awg1Now] != 1) || ([:len $recheckNow] != 1)) do={
                  :set slowStateReady false
                }
              }

              :if ($slowStateReady = true) do={
                :onerror slowTestClearError in={
                  /ip firewall address-list remove [find where list=$testList and address=$dst]
                } do={
                  :set slowStateReady false
                }

                :if ([:len [/ip firewall address-list find where list=$testList and address=$dst]] > 0) do={
                  :set slowStateReady false
                }
              }

              :if ($slowStateReady = true) do={
                :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$coolList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}

                :onerror slowFirstAwgConnRemoveError in={
                  /ip firewall connection remove $id
                } do={}

                :if ({{LOG_DEBUG}}) do={
                  :log warning ("AUTO-AWG: SLOW AWG evidence 1; returning to DIRECT re-check " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                }
              } else={
                :onerror err in={ /ip firewall address-list remove [find where list=$awg1List and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$recheckList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$testList and address=$dst] } do={}

                :if ([:len [/ip firewall address-list find where list=$testList and address=$dst]] > 0) do={
                  :local slowTestRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " TEST")

                  :onerror slowTestRuleRemoveError in={
                    /ip firewall mangle remove [find where comment=$slowTestRuleComment]
                  } do={}
                }

                :onerror slowFailedStateConnRemoveError in={
                  /ip firewall connection remove $id
                } do={}

                :if ({{LOG_ERROR}}) do={
                  :log warning ("AUTO-AWG: SLOW re-check state creation failed; keeping DIRECT for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                }
              }
            } else={
              :if (([:len $awg1Ids] != 1) || ([:len $recheckIds] > 0)) do={
                :onerror err in={ /ip firewall address-list remove [find where list=$testList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$awg1List and address=$dst] } do={}
                :onerror err in={ /ip firewall address-list remove [find where list=$recheckList and address=$dst] } do={}

                :if ([:len [/ip firewall address-list find where list=$testList and address=$dst]] > 0) do={
                  :local slowTestRuleComment ("AUTO-AWG: P " . $proto . " " . [:tostr $port] . " TEST")

                  :onerror slowTestRuleRemoveError in={
                    /ip firewall mangle remove [find where comment=$slowTestRuleComment]
                  } do={}
                }

                :onerror slowInconsistentConnRemoveError in={
                  /ip firewall connection remove $id
                } do={}

                :if ({{LOG_ERROR}}) do={
                  :log warning ("AUTO-AWG: SLOW inconsistent AWG/re-check state reset to DIRECT for " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
                }
              } else={
                :if (($evidenceReadable = false) || ($sameEvidence = true)) do={
                  :onerror slowAwgRepeatRemoveError in={
                    /ip firewall connection remove $id
                  } do={}
                } else={
                  :set confirmOK true
                }
              }
            }
          }
        }

        :if ($confirmOK = true) do={
          :if ([:len [/ip firewall address-list find where list=$okList and address=$dst]] = 0) do={
            /ip firewall address-list add list=$okList address=$dst timeout=6h comment=("AUTO confirmed " . $proto . ":" . [:tostr $port])

            :if ({{LOG_INFO}}) do={
              :log info ("AUTO-AWG: CONFIRMED " . [:tostr $dst] . " via " . $proto . ":" . [:tostr $port])
            }
          }

          :onerror err in={ /ip firewall address-list remove [find where list=$testList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$coolList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$awg1List and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$recheckList and address=$dst] } do={}
        }
      }

      :if (($good = false) && ($failed = true)) do={
        :onerror err in={ /ip firewall address-list remove [find where list=$testList and address=$dst] } do={}
        :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
        :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}
        :onerror err in={ /ip firewall address-list remove [find where list=$awg1List and address=$dst] } do={}
        :onerror err in={ /ip firewall address-list remove [find where list=$recheckList and address=$dst] } do={}

        :if ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0) do={
          /ip firewall address-list add list=$coolList address=$dst timeout=5m comment=("DIRECT+AWG failed " . $proto . ":" . [:tostr $port])
        }

        :onerror err in={
          /ip firewall connection remove $id
        } do={}
      }
    }

    :if (($directHit = false) && ($connMark = "auto-awg-ok-conn") && ($okList != "")) do={
      :local okId [/ip firewall address-list find where list=$okList and address=$dst]

      :if ([:len $okId] > 0) do={
        :local failed false
        :local healthy false

        :if ($proto = "tcp") do={
          :local state [:tostr ($c->"tcp-state")]

          :if (($rp >= 2) || ($rb >= 128)) do={
            :set healthy true
          }

          :if (($state = "syn-sent") && ($op >= 4) && ($rp = 0)) do={
            :set failed true
          }

          :if (($state = "established") && ($op >= 15) && ($ob >= 5000) && ($rp <= 1) && ($rb < 128)) do={
            :set failed true
          }
        }

        :if ($proto = "udp") do={
          :if ($rp >= 1) do={
            :set healthy true
          }

          :if (($port = 443) && ($op >= 16) && ($rp = 0)) do={
            :set failed true
          }
        }

        :if ($failed = true) do={
          :onerror err in={ /ip firewall address-list remove [find where list=$okList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$testList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$watchList and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$direct1List and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$awg1List and address=$dst] } do={}
          :onerror err in={ /ip firewall address-list remove [find where list=$recheckList and address=$dst] } do={}

          :if ([:len [/ip firewall address-list find where list=$coolList and address=$dst]] = 0) do={
            /ip firewall address-list add list=$coolList address=$dst timeout=30s comment=("Confirmed AWG " . $proto . " route failed")
          }

          :onerror err in={
            /ip firewall connection remove $id
          } do={}
        } else={
          :if ($healthy = true) do={
            :onerror err in={
              :local left [/ip firewall address-list get $okId timeout]

              :if ($left <= 3h) do={
                :local oldComment [:tostr [/ip firewall address-list get $okId comment]]
                /ip firewall address-list remove $okId
                /ip firewall address-list add list=$okList address=$dst timeout=6h comment=$oldComment
              }
            } do={}
          }
        }
      }
    }
  }
  } do={}
}
}
